# Copy this file to .env.local and fill in the values.
# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Site URL used for share links and auth confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Code execution: goboxd (required). Base URL of the self-hosted goboxd server.
# In production this is the Cloudflare Tunnel hostname, e.g.
# https://goboxd.nithitsuki.com (keep it private/behind the tunnel — never let
# the browser call goboxd directly). Kept server-side only.
GOBOXD_API_URL=https://goboxd.nithitsuki.com

# Code execution: goboxd shared secret (optional, but REQUIRED in production).
# Sent as `Authorization: Bearer <token>`. Must match the GOBOXD_AUTH_TOKEN set
# on the goboxd server. Keep server-side only — never expose it to the browser.
GOBOXD_AUTH_TOKEN=

# Per-user code submission rate limit (server-side only, optional).
# Enforced by the submit_rate_limits table + bump_submit_rate() function in
# supabase-submit-rate-limit.sql. Defaults shown.
SUBMIT_RATE_LIMIT=20                    # max submissions per user per window
SUBMIT_RATE_WINDOW_SECONDS=20           # window length in seconds